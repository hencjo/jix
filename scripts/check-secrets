#!/usr/bin/env python3
"""Scan all local Git refs and publishable working files; never print secrets."""
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parents[1]


def main():
    os.chdir(ROOT)
    common = ["--redact=100", "--no-banner", "--config", str(ROOT / ".gitleaks.toml")]
    history = subprocess.run(["gitleaks", "git", *common, "--log-opts=--all", "."])
    staged = subprocess.run(["gitleaks", "git", *common, "--staged", "."])
    paths = subprocess.check_output([
        "git", "ls-files", "-z", "--cached", "--others", "--exclude-standard",
    ]).split(b"\0")
    with tempfile.TemporaryDirectory(prefix="jix-secrets-") as directory:
        for raw in set(paths) - {b""}:
            relative = Path(os.fsdecode(raw))
            source = ROOT / relative
            target = Path(directory) / relative
            if source.is_symlink():
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_text(os.readlink(source))
            elif source.is_file():
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(source, target)
            elif source.exists():
                raise RuntimeError(f"Unsupported entry (submodule?): {relative}")
            # Locally deleted tracked files remain covered by the history scan.
        worktree = subprocess.run(["gitleaks", "dir", *common, directory])
    return history.returncode or staged.returncode or worktree.returncode


if __name__ == "__main__":
    raise SystemExit(main())
